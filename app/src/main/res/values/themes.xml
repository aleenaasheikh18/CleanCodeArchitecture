<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" >
        <item name="fontFamily">@font/monstreat_medium</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <style name="NavTextStyle" parent="Widget.Material3.NavigationView">
        <item name="android:textSize">@dimen/new_dimen_21_sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="maxLines">2</item>
    </style>

    <!-- Base Bottom Sheet Dialog Style -->
    <style name="BaseBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BaseBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BaseBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/BaseBottomSheetShapeAppearance</item>
    </style>

    <style name="BaseBottomSheetShapeAppearance" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/new_dimen_20_dp</item>
        <item name="cornerSizeTopRight">@dimen/new_dimen_20_dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Wizard Styles -->
    <style name="WizardTitle">
        <item name="android:textColor">@color/titleColor</item>
        <item name="android:textSize">@dimen/txt_mediumX</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WizardDescription">
        <item name="android:textColor">@color/colorLightGray</item>
        <item name="android:textSize">@dimen/txt_mediumX</item>
    </style>

    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/new_dimen_48_dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">@dimen/new_dimen_16_dp</item>
        <item name="android:paddingEnd">@dimen/new_dimen_48_dp</item>
        <item name="android:textColor">@color/colorBlack</item>
        <item name="android:textColorHint">@color/colorLightGray</item>
        <item name="android:textSize">@dimen/txt_mediumX</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/new_dimen_48_dp</item>
        <item name="android:background">@drawable/button_rounded_black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/defaultButtonTextColor</item>
        <item name="android:textSize">@dimen/txt_mediumXX</item>
    </style>

    <style name="ErrorText">
        <item name="android:textColor">@color/defaultColorPrimary</item>
        <item name="android:textSize">@dimen/txt_smallXX</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="ClearIcon">
        <item name="android:layout_width">@dimen/new_dimen_24_dp</item>
        <item name="android:layout_height">@dimen/new_dimen_24_dp</item>
        <item name="android:src">@drawable/ic_input_clear</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>