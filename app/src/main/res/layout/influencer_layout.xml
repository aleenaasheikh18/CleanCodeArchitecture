<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/llInfluencer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/new_dimen_12_dp"
        android:orientation="vertical"
        android:padding="@dimen/new_dimen_8_dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monstreat_medium"
                    android:text="@string/your_referral_link"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/new_dimen_10_dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShare"
                    android:layout_width="100dp"
                    android:layout_height="@dimen/new_dimen_30_dp"
                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                    android:background="@drawable/tag_red"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="@string/share"
                    android:textAllCaps="false"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/new_dimen_8_dp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorShadow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/new_dimen_4_dp"
                    app:cardElevation="@dimen/new_dimen_1_dp"
                    app:cardUseCompatPadding="true">

                    <ImageView
                        android:id="@+id/ivQR"
                        android:layout_width="@dimen/new_dimen_72_dp"
                        android:layout_height="@dimen/new_dimen_72_dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWithdraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/new_dimen_8_dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/new_dimen_8_dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monstreat_medium"
                    android:text="@string/signups_this_week"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/new_dimen_8_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/new_dimen_60_dp"
                        android:layout_marginEnd="@dimen/new_dimen_4_dp"
                        android:background="@drawable/square_border"
                        android:gravity="start|center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llThisSignups"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="start|center"
                            android:orientation="horizontal"
                            android:padding="@dimen/new_dimen_8_dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvThisSignups"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="@color/textColorBlack"
                                android:textSize="@dimen/new_dimen_14_dp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCountSignupLastWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="@string/zero"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/new_dimen_10_dp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/new_dimen_2_dp"
                                    android:fontFamily="@font/monstreat_medium"
                                    android:text="@string/last_week"
                                    android:textColor="@color/textColorBlack"
                                    android:textSize="@dimen/new_dimen_10_dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                                    android:gravity="end"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/ic_nav_home" />

                                    <TextView
                                        android:id="@+id/tvUpSignupLastWeek"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/new_dimen_2_dp"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:text="@string/_0"
                                        android:textColor="@color/colorGreen"
                                        android:textSize="@dimen/new_dimen_8_dp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvThisSignupsZero"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:text="@string/zero"
                            android:textColor="@color/black"
                            android:textSize="@dimen/new_dimen_14_dp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_4_dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monstreat_medium"
                    android:text="@string/purchased_this_week"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/new_dimen_8_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/new_dimen_60_dp"
                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                    android:background="@drawable/square_border"
                    android:gravity="start|center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llThisPurchased"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:padding="@dimen/new_dimen_8_dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvThisPurchased"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textColor="@color/textColorBlack"
                            android:textSize="@dimen/new_dimen_14_dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountMenuLastWeek"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="@string/zero"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/new_dimen_10_dp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/new_dimen_2_dp"
                                android:fontFamily="@font/monstreat_medium"
                                android:text="@string/last_week"
                                android:textColor="@color/textColorBlack"
                                android:textSize="@dimen/new_dimen_10_dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/new_dimen_4_dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_nav_home" />

                                <TextView
                                    android:id="@+id/tvUpMenuLastWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/new_dimen_2_dp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="@string/_0"
                                    android:textColor="@color/colorGreen"
                                    android:textSize="@dimen/new_dimen_8_dp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvThisPurchasedZero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="@string/zero"
                        android:textColor="@color/black"
                        android:textSize="@dimen/new_dimen_14_dp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/new_dimen_8_dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monstreat_medium"
                    android:text="@string/signups_last_month"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/new_dimen_8_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/new_dimen_60_dp"
                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                    android:background="@drawable/square_border"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llLastSignups"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/new_dimen_4_dp"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:padding="@dimen/new_dimen_8_dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvLastSignups"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textColor="@color/textColorBlack"
                            android:textSize="@dimen/new_dimen_14_dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountSignupLastMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="@string/zero"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/new_dimen_10_dp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/new_dimen_2_dp"
                                android:fontFamily="@font/monstreat_medium"
                                android:text="@string/last_month"
                                android:textColor="@color/textColorBlack"
                                android:textSize="@dimen/new_dimen_10_dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/new_dimen_4_dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_nav_home" />

                                <TextView
                                    android:id="@+id/tvUpSignupLastMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/new_dimen_2_dp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="@string/_0"
                                    android:textColor="@color/colorGreen"
                                    android:textSize="@dimen/new_dimen_8_dp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastSignupsZero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="@string/zero"
                        android:textColor="@color/black"
                        android:textSize="@dimen/new_dimen_14_dp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_4_dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monstreat_medium"
                    android:text="@string/purchased_last_month"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/new_dimen_8_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/new_dimen_60_dp"
                    android:layout_marginTop="@dimen/new_dimen_4_dp"
                    android:background="@drawable/square_border"
                    android:gravity="start|center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llLastPurchased"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:padding="@dimen/new_dimen_8_dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvLastPurchased"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textColor="@color/textColorBlack"
                            android:textSize="@dimen/new_dimen_14_dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCountMenuLastMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="@string/zero"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/new_dimen_10_dp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/new_dimen_2_dp"
                                android:fontFamily="@font/monstreat_medium"
                                android:text="@string/last_month"
                                android:textColor="@color/textColorBlack"
                                android:textSize="@dimen/new_dimen_10_dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/new_dimen_4_dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_nav_home" />

                                <TextView
                                    android:id="@+id/tvUpMenuLastMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/new_dimen_2_dp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="@string/_0"
                                    android:textColor="@color/colorGreen"
                                    android:textSize="@dimen/new_dimen_8_dp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastPurchasedZero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="@string/zero"
                        android:textColor="@color/black"
                        android:textSize="@dimen/new_dimen_14_dp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>