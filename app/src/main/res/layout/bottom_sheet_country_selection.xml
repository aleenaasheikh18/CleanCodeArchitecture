<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_background"
    android:orientation="vertical">

    <!-- Drag Handle -->
    <include layout="@layout/layout_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/new_dimen_16_dp">

        <TextView
            style="@style/WizardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_select_country" />

        <ImageView
            android:id="@+id/ivClose"
            style="@style/ClearIcon"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/close_"
            android:visibility="visible" />

    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorGreyBackground" />

    <!-- Search -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/new_dimen_16_dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSearch"
            style="@style/InputField"
            android:hint="@string/hint_search_country"
            android:inputType="text" />

        <ImageView
            android:id="@+id/ivClearSearch"
            style="@style/ClearIcon"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/new_dimen_12_dp"
            android:contentDescription="@string/clear_search" />

    </FrameLayout>

    <!-- Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Country List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCountries"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/new_dimen_24_dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                style="@style/WizardDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/error_loading_countries" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                style="@style/PrimaryButton"
                android:layout_marginTop="@dimen/new_dimen_16_dp"
                android:text="@string/btn_retry" />

        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmpty"
            style="@style/WizardDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_results_found"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
