<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/new_dimen_264_dp"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    android:padding="@dimen/standard_size">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/new_dimen_30_dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgProfile"
            android:layout_width="@dimen/image_size"
            android:layout_height="@dimen/image_size"
            android:layout_gravity="center"
            android:background="@drawable/circle_background"
            android:contentDescription="Profile Image"
            android:gravity="center"
            android:text="NH"
            android:textColor="@color/white"
            android:textSize="@dimen/new_dimen_40_sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivInfluencer"
            android:layout_width="@dimen/new_dimen_40_dp"
            android:layout_height="@dimen/new_dimen_40_dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:src="@drawable/ic_verified"
            android:contentDescription="Notification Badge" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/new_dimen_12_sp"
        android:layout_marginBottom="@dimen/new_dimen_30_dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="John Doe"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="@dimen/new_dimen_25_sp"
        android:textStyle="bold" />

</LinearLayout>
