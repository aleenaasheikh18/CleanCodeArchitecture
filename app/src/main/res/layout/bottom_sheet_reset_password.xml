<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/new_dimen_40_dp"
        android:layout_height="@dimen/new_dimen_4_dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/new_dimen_12_dp"
        android:background="@drawable/bg_input_field" />

    <!-- Generic Header -->
    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_wizard_header" />

    <!-- Divider -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorGreyBackground"
        android:visibility="gone" />

    <!-- ViewFlipper for wizard screens -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right">

        <!-- Screen 1: Reset Password Form -->
        <include
            android:id="@+id/layoutResetPassword"
            layout="@layout/layout_wizard_reset_password" />

        <!-- Screen 2: Success Screen -->
        <include
            android:id="@+id/layoutSuccess"
            layout="@layout/layout_wizard_phone_success" />

    </ViewFlipper>

</LinearLayout>
