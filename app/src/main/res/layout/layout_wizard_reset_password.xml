<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/new_dimen_24_dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/please_enter_pc"
        android:textColor="@color/colorLightGray"
        android:textSize="@dimen/standard_sub_title_size" />

    <!-- New Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/new_dimen_24_dp"
        app:boxStrokeColor="@color/colorBlack"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/colorLightGray"
        app:hintTextColor="@color/colorBlack">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/new_dimen_48_dp"
            android:hint="@string/new_password"
            android:inputType="textPassword"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/standard_sub_title_size" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/new_dimen_16_dp"
        app:boxStrokeColor="@color/colorBlack"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/colorLightGray"
        app:hintTextColor="@color/colorBlack">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/new_dimen_48_dp"
            android:hint="@string/confirm_password"
            android:inputType="textPassword"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/standard_sub_title_size" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Requirements -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/new_dimen_16_dp"
        android:orientation="vertical">

        <!-- Min 12 characters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/new_dimen_4_dp">

            <ImageView
                android:id="@+id/ivMinLength"
                android:layout_width="@dimen/new_dimen_16_dp"
                android:layout_height="@dimen/new_dimen_16_dp"
                android:src="@drawable/ic_close"
                app:tint="@color/defaultColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_8_dp"
                android:text="@string/your_password_length"
                android:textColor="@color/colorLightGray"
                android:textSize="@dimen/standard_text_size" />
        </LinearLayout>

        <!-- Must contain number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/new_dimen_4_dp">

            <ImageView
                android:id="@+id/ivNumber"
                android:layout_width="@dimen/new_dimen_16_dp"
                android:layout_height="@dimen/new_dimen_16_dp"
                android:src="@drawable/ic_close"
                app:tint="@color/defaultColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_8_dp"
                android:text="@string/must_contain_number"
                android:textColor="@color/colorLightGray"
                android:textSize="@dimen/standard_text_size" />
        </LinearLayout>

        <!-- Must contain capital letter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/new_dimen_4_dp">

            <ImageView
                android:id="@+id/ivCapital"
                android:layout_width="@dimen/new_dimen_16_dp"
                android:layout_height="@dimen/new_dimen_16_dp"
                android:src="@drawable/ic_close"
                app:tint="@color/defaultColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_8_dp"
                android:text="@string/must_contain_capital"
                android:textColor="@color/colorLightGray"
                android:textSize="@dimen/standard_text_size" />
        </LinearLayout>

        <!-- Must contain symbol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/new_dimen_4_dp">

            <ImageView
                android:id="@+id/ivSymbol"
                android:layout_width="@dimen/new_dimen_16_dp"
                android:layout_height="@dimen/new_dimen_16_dp"
                android:src="@drawable/ic_close"
                app:tint="@color/defaultColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_8_dp"
                android:text="@string/must_contain_symbol"
                android:textColor="@color/colorLightGray"
                android:textSize="@dimen/standard_text_size" />
        </LinearLayout>

        <!-- Passwords must match -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/new_dimen_4_dp">

            <ImageView
                android:id="@+id/ivPasswordsMatch"
                android:layout_width="@dimen/new_dimen_16_dp"
                android:layout_height="@dimen/new_dimen_16_dp"
                android:src="@drawable/ic_close"
                app:tint="@color/defaultColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/new_dimen_8_dp"
                android:text="@string/passwords_must_match"
                android:textColor="@color/colorLightGray"
                android:textSize="@dimen/standard_text_size" />
        </LinearLayout>

    </LinearLayout>

    <!-- Reset Password Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnResetPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/new_dimen_48_dp"
        android:layout_marginTop="@dimen/new_dimen_24_dp"
        android:alpha="0.5"
        android:background="@drawable/button_rounded_black"
        android:enabled="false"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/defaultButtonTextColor"
        android:textSize="@dimen/standard_sub_title_size" />

</LinearLayout>
